# Committed defaults; the generated `sdkconfig` is ignored (plan › Project Structure).
CONFIG_IDF_TARGET="esp32s3"

# Encrypted NVS for Wi-Fi credentials and keys (research R-007, plan › Security).
# HMAC scheme: the NVS key is derived from an eFuse HMAC key. If key block 0 is
# empty, the first nvs_flash_secure_init() burns a random key into it, which is a
# one-time, irreversible eFuse write on the board.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=0

# MQTT 5 over TLS (ESP-MQTT with Mbed TLS); TLS 1.2 minimum.
CONFIG_MQTT_PROTOCOL_5=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y

# SNTP time (UTC) with up to two servers.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Keep the main task stack roomy for TLS setup.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
