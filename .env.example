# Non-secret settings for the local stack. Copy to `.env` (ignored) and edit.
# Never put keys, tokens, passwords, or Wi-Fi credentials here: they live only
# in infrastructure/secrets/ (see infrastructure/secrets/README.example.md).

# LAN address of the server host that publishes 8883 and 443 (documentation range here).
LAN_BIND_ADDRESS=192.0.2.10
# Trusted subnets allowed to reach 8883/443 (host firewall; plan › Security).
TRUSTED_SUBNET_CIDR=192.0.2.0/24
# Published ports: MQTT over mutual TLS and the HTTPS dashboard (the only two).
MQTT_TLS_PORT=8883
HTTPS_PORT=443
# Host name the dashboard certificate is issued for (local, non-public).
DASHBOARD_HOSTNAME=energy.lab.internal
# Display time zone; storage is always UTC.
TZ=America/Lima
# Notification endpoint base URL (placeholder; the token is a secret file).
NOTIFY_BASE_URL=https://notify.example.invalid
